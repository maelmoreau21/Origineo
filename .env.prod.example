# ──────────────────────────────────────
# Origineo — Production Environment
# ──────────────────────────────────────
# Copy this file to .env.prod and set secure values.
# NEVER commit .env.prod to version control.

# Database (REQUIRED — use a strong password)
DB_USER=origineo
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=origineo
DB_PORT=5432

# JWT Authentication (REQUIRED — use a 64+ char random string)
# Generate: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRATION=7d

# Compte administrateur local (REQUIRED — changer pour un mot de passe fort)
LOCAL_ADMIN_EMAIL=admin@votre-domaine.com
LOCAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
LOCAL_ADMIN_NAME=Administrateur

# SSO OpenID Connect (OIDC) (OPTIONNEL)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.votre-domaine.com/application/o/origineo/
OIDC_CLIENT_ID=origineo-client
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_SECRET
OIDC_REDIRECT_URI=https://votre-domaine.com/api/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_ADMIN_CLAIM=groups
OIDC_ADMIN_VALUE=origineo-admin
OIDC_BUTTON_LABEL=Se connecter avec SSO
FRONTEND_URL=https://votre-domaine.com

# API
API_PORT=3001

# Frontend (set to your production URL)
NEXT_PUBLIC_API_URL=https://votre-domaine.com

# Nginx ports
HTTP_PORT=80
HTTPS_PORT=443

# Node
NODE_ENV=production
