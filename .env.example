# ─── Application & Base de données ───────────────────────────────────
APP_PORT=8080
POSTGRES_USER=origineo
POSTGRES_PASSWORD=origineo_secret
POSTGRES_DB=origineo
DATABASE_URL=postgres://origineo:origineo_secret@localhost:5432/origineo

# Secret JWT pour le cookie de session HttpOnly (minimum 32 caractères aléatoires)
JWT_SECRET=changez_moi_avec_une_cle_aleatoire_de_32_caracteres_minimum
COOKIE_SECURE=false

# Dossiers locaux (hors Docker)
STORAGE_PATH=./storage
STATIC_DIR=../frontend/build
FRONTEND_URL=http://localhost:8080

# ─── Authentification 100% SSO OIDC (PKCE S256) ──────────────────────
# Compatible Authentik, Keycloak, Pocket ID, Authelia, Zitadel, Azure AD, Okta...
OIDC_ISSUER_URL=https://auth.example.com/application/o/origineo/
OIDC_CLIENT_ID=origineo-client
OIDC_CLIENT_SECRET=votre-client-secret-oidc
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
OIDC_SCOPES="openid profile email groups"
OIDC_BUTTON_LABEL="Se connecter avec SSO (OIDC)"

# ─── Attribution automatique des 3 grades via Claims / Groupes OIDC ──
# 1. ADMIN (Administrateur) : Tous les droits + Import/Export/Fusion GEDCOM
# 2. MODIFIER (Modificateur) : Création/modification/suppression des personnes & documents
# 3. READER (Lecteur) : Lecture seule de l'arbre, recherche fuzzy & calcul de parenté BFS
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_VALUES=admin,administrateur,origineo-admin
OIDC_MODIFIER_VALUES=modifier,modificateur,editor,origineo-modifier
OIDC_READER_VALUES=reader,lecteur,viewer,origineo-reader
OIDC_DEFAULT_ROLE=READER
OIDC_REQUIRE_GROUP=false

# Mode test local sans fournisseur OIDC externe (désactiver impérativement en production)
OIDC_DEV_MOCK=true
