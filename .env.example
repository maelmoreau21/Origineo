# ──────────────────────────────────────
# Origineo — Environment Variables
# ──────────────────────────────────────

# Database
DB_USER=origineo
DB_PASSWORD=origineo_secret_change_me
DB_NAME=origineo
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# JWT Authentication
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRATION=7d

# Compte administrateur local (initialisé / synchronisé automatiquement)
LOCAL_ADMIN_EMAIL=admin@origineo.local
LOCAL_ADMIN_PASSWORD=admin123456
LOCAL_ADMIN_NAME=Administrateur

# SSO OpenID Connect (OIDC: Authentik, Keycloak, Authelia, Google, Azure AD...)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_ADMIN_CLAIM=groups
OIDC_ADMIN_VALUE=origineo-admin
OIDC_BUTTON_LABEL=Se connecter avec SSO
FRONTEND_URL=http://localhost:3000

# API
API_PORT=3001
API_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Node
NODE_ENV=development
